  "B站设置": {
    "type": "object",
    "description": "B站设置",
    "items": {
      "BILI_CK": {
        "description": "哔哩哔哩 Cookie",
        "type": "text",
        "default": "",
        "invisible": true,
        "hint": "可在「配置 → 账号凭据 → B站」或总览页扫码登录；画质按账号权限获取",
        "secret": true
      },
      "BILI_QUALITY": {
        "description": "B站下载清晰度",
        "type": "string",
        "default": "1080P",
        "invisible": true,
        "hint": "高画质需要对应账号权限；未登录时实际只能拿到 720P",
        "options": [
          "360P",
          "480P",
          "720P",
          "1080P",
          "1080P+",
          "4K",
          "8K"
        ]
      },
      "BILI_CODEC": {
        "description": "B站视频编码偏好",
        "type": "string",
        "default": "H.264 优先",
        "invisible": true,
        "hint": "同一个视频 B站提供多种压缩格式，这里决定优先下哪一种。H.264 任何客户端都能播；AV1 体积最小但老客户端（如电脑版 QQ）放出来会花屏；H.265 介于两者之间。4K/8K 往往只有 H.265/AV1 可选，此时会自动退而求其次，不会下载失败——所以切到 H.264 优先不会让 4K 视频下不下来，只会拿不到该档的 H.264 版本",
        "options": [
          "H.264 优先",
          "H.265 优先",
          "AV1 优先"
        ]
      },
      "BILI_EXTRA_INFO_TIMEOUT_SECONDS": {
        "description": "B站附加信息等待",
        "type": "int",
        "default": 5,
        "invisible": true,
        "hint": "卡片等待在线人数和 AI 摘要的上限，不是视频解析总超时；调大会延长部分卡片的等待。",
        "min": 1,
        "max": 30,
        "unit": "秒"
      }
    },
    "invisible": true
  },
