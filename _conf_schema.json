      },
      "AUDIO_SEND_MODE": {
        "description": "音频发送方式",
        "type": "string",
        "default": "voice",
        "invisible": false,
        "hint": "语音条发送失败时自动改发音频文件；音频文件则直接发文件。超时可能导致语音和文件同时送达；接口返回成功但客户端未收到时无法检测。分容器发送文件可使用中转、共享目录或宿主路径映射。",
        "options": [
          "voice",
          "file"
        ],
        "labels": [
          "语音条",
          "音频文件"
        ]
      },
