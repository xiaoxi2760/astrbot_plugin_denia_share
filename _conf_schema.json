{
  "解析设置": {
    "type": "object",
    "description": "日常最常用到的几项",
    "items": {
      "DISABLED_PLATFORMS": {
        "description": "禁用的平台(逗号分隔)",
        "type": "string",
        "default": "",
        "hint": "可选: bilibili,douyin,kuaishou,weibo,xiaohongshu,twitter,nga,acfun（留空=全部启用）",
        "obvious_hint": false
      },
      "VIDEO_DURATION_MAXIMUM": {
        "description": "视频最大时长(秒)",
        "type": "int",
        "default": 480,
        "hint": "超过此时长不下载视频，但仍会返回标题、作者和封面",
        "obvious_hint": true
      },
      "VIDEO_SIZE_MAXIMUM_MB": {
        "description": "单个视频体积上限(MB)",
        "type": "int",
        "default": 100,
        "hint": "下载前按 Content-Length 判断，边下边判。QQ 大文件上传容易失败，建议不超过 60",
        "obvious_hint": true
      },
      "SEND_ERROR_MESSAGES": {
        "description": "解析失败时发送错误提示",
        "type": "bool",
        "default": false,
        "hint": "关闭则只写日志、不在群里刷报错。排查问题时可临时打开",
        "obvious_hint": true
      }
    }
  },
  "B站设置": {
    "type": "object",
    "description": "B站 Cookie 与下载清晰度",
    "items": {
      "BILI_CK": {
        "description": "哔哩哔哩 Cookie",
        "type": "string",
        "default": "",
        "hint": "推荐用 /bili_login 扫码登录自动获取并持久化；配了才能下 1080P 及以上",
        "obvious_hint": true
      },
      "BILI_QUALITY": {
        "description": "B站下载清晰度",
        "type": "string",
        "default": "1080P",
        "hint": "360P / 480P / 720P / 1080P / 1080P+ / 4K / 8K，高画质需要对应账号权限",
        "obvious_hint": true
      }
    }
  },
  "卡片外观": {
    "type": "object",
    "description": "把解析结果渲染成分享卡片图片",
    "items": {
      "RENDER_ENABLED": {
        "description": "启用卡片渲染",
        "type": "bool",
        "default": true,
        "hint": "关闭则回退为纯文本输出",
        "obvious_hint": true
      },
      "RENDER_THEME": {
        "description": "卡片主题",
        "type": "string",
        "default": "dark",
        "hint": "dark（深色） / light（浅色）",
        "obvious_hint": true
      },
      "RENDER_LAYOUT": {
        "description": "卡片布局",
        "type": "string",
        "default": "standard",
        "hint": "standard / magazine / immersive / feed",
        "obvious_hint": false
      }
    }
  },
  "高级设置": {
    "type": "object",
    "description": "一般用不到，按需开启",
    "items": {
      "XHS_CK": {
        "description": "小红书 Cookie",
        "type": "string",
        "default": "",
        "hint": "部分笔记需要登录态才能完整解析，从浏览器复制 xiaohongshu.com 的 cookie",
        "obvious_hint": true
      },
      "PROXY": {
        "description": "媒体下载代理",
        "type": "string",
        "default": "",
        "hint": "形如 http://127.0.0.1:7897，留空不使用。注意这是运行 AstrBot 那台机器上的地址",
        "obvious_hint": false
      },
      "TWITTER_MEDIA_PROXY_BASE": {
        "description": "Twitter 图片/视频反代根地址",
        "type": "string",
        "default": "",
        "hint": "留空=不启用。服务器连不上 twimg 时填写，如 https://your-proxy.example",
        "obvious_hint": false
      },
      "CACHE_TTL_HOURS": {
        "description": "缓存保留时长(小时)",
        "type": "int",
        "default": 24,
        "hint": "超过此时间未使用的缓存会被自动清理。设为 0 禁用自动清理",
        "obvious_hint": false
      },
      "RENDER_FONT_PATH": {
        "description": "自定义字体文件",
        "type": "string",
        "default": "",
        "hint": "留空自动探测系统字体；卡片出现方块字时才需要指定",
        "obvious_hint": false
      }
    }
  }
}
