  "网页截图": {
    "type": "object",
    "description": "网页截图范围",
    "items": {
      "SCREENSHOT_BACKEND": {
        "description": "截图后端",
        "type": "string",
        "default": "thum",
        "invisible": true,
        "hint": "thum=image.thum.io，900×900 视窗图开箱即用；cloudflare 可截长图/等待 JS，但必须有账号",
        "options": [
          "thum",
          "cloudflare"
        ],
        "labels": [
          "thum（免 key）",
          "cloudflare（需账号）"
        ]
      },
      "SCREENSHOT_FULL_PAGE": {
        "description": "截整页长图",
        "type": "bool",
        "default": true,
        "invisible": false,
        "hint": "开启=截整页（长文章能看全），关闭=只截首屏视窗。实测差别很大：同一个维基长文关掉只有 900×900 的方图（约 0.3 MB，只看到顶部一小块），开完整页约 4.4 MB、高度按页面内容走（thum 上限 16000px，触顶时底部会缺）。代价是长图可能几 MB、群里发出去客户端会压缩，所以默认开启但可关。两个后端都支持整页（thum 走 /fullpage，cloudflare 走 fullPage）"
      },
      "SCREENSHOT_FALLBACK": {
        "description": "匹配不到平台的链接自动截图",
        "type": "bool",
        "default": false,
        "invisible": true,
        "hint": "默认关闭，避免群里刷图。开启后任何解析不了的 http 链接都会尝试截图"
      },
      "CF_ACCOUNT_ID": {
        "description": "Cloudflare Account ID",
        "type": "string",
        "default": "",
        "invisible": true,
        "hint": "仅 cloudflare 后端需要，在 CF 控制台右侧栏可复制"
      },
      "CF_API_TOKEN": {
        "description": "Cloudflare API Token",
        "type": "string",
        "default": "",
        "invisible": true,
        "hint": "仅 cloudflare 后端需要，需带 Browser Rendering 写权限",
        "secret": true
      },
      "SCREENSHOT_TIMEOUT_SECONDS": {
        "description": "截图请求超时",
        "type": "int",
        "default": 60,
        "invisible": true,
        "hint": "等待截图服务响应的本地请求预算；CF 页面加载预算是另一个计时器，需为截图生成和传输留出时间。",
        "min": 10,
        "max": 300,
        "unit": "秒"
      },
      "SCREENSHOT_CF_WAIT_UNTIL": {
