          "domcontentloaded",
          "networkidle0",
          "networkidle2"
        ],
        "labels": [
          "页面加载完成",
          "DOM 就绪",
          "网络完全空闲",
          "网络基本空闲"
        ]
      },
      "SCREENSHOT_CF_GOTO_TIMEOUT_MS": {
        "description": "CF 页面加载预算",
        "type": "int",
        "default": 45000,
        "invisible": true,
        "hint": "仅影响 Cloudflare 服务端页面加载，最多 60000ms；本地截图请求超时应留有余量。",
        "min": 1000,
        "max": 60000,
        "unit": "毫秒"
      }
    },
    "invisible": false
  },
  "输出模式": {
    "type": "object",
    "description": "发送内容与下载确认",
    "items": {
      "OUTPUT_TEXT_ENABLED": {
        "description": "文本",
        "type": "bool",
        "default": false,
        "invisible": true,
        "hint": "一条普通文字消息，包含标题、链接、简洁播放信息与必要提示。可与卡片、富媒体同时发送。"
      },
      "OUTPUT_CARD_ENABLED": {
